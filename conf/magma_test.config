/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    MAGMA mode test profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Minimal test for --mode magma: 3 downsampled M. tuberculosis samples
    (EXIT-RIF / PRJNA1026351: SRR26331590/595/599) on Zenodo (doi 10.5281/zenodo.20671479).

    Use as follows:
        nextflow run nf-core/tbanalyzer -profile test_magma,docker --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

// The mode-gated includes in nextflow.config evaluate params.mode at parse time
// (default 'mtbseq'), so a profile that only sets mode='magma' is too late to
// trigger them. Load the MAGMA base params + per-process config here explicitly
// so `-profile test_magma` is self-sufficient without also passing --mode magma.
includeConfig 'magma_base.config'
includeConfig 'magma_modules.config'

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '2.h'
    ]
}

params {
    config_profile_name        = 'MAGMA test profile'
    config_profile_description = 'Minimal test to check the MAGMA mode (3 downsampled M. tuberculosis samples)'

    mode               = 'magma'

    // MAGMA-native samplesheet (Study,Sample,Library,Attempt,R1,R2,Flowcell,Lane,Index Sequence)
    input              = "${projectDir}/assets/magma_samplesheet_test.csv"
    magma_vcf_name     = 'test'

    // Skip slow / resource-heavy analyses for CI (VQSR needs many samples; BQSR off for Mtb)
    magma_skip_variant_recalibration    = true
    magma_skip_base_recalibration       = true
    magma_skip_tbprofiler_fastq         = true
    magma_skip_spotyping                = true
    magma_skip_rdanalyzer               = true
    magma_skip_ismapper                 = true

    // Keep per-sample calling + basic cohort analyses
    magma_skip_merge_analysis           = false
    magma_skip_phylogeny_and_clustering = false
    magma_skip_complex_regions          = false
    magma_skip_ntmprofiler              = false
    magma_skip_minor_variants_gatk      = true

    // Fast ML tree (no bootstrap) for short runtime
    magma_iqtree_standard_bootstrap          = false
    magma_iqtree_fast_ml_only                = true
    magma_iqtree_fast_bootstrapped_phylogeny = false
    magma_iqtree_accurate_ml_only            = false
}
