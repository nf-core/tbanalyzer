/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per-module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
        ext.when   = Condition for running module (null or true = run; false = skip).
----------------------------------------------------------------------------------------
*/

process {

    // ================================================================================
    // Default publishing (overridden per process below)
    // ================================================================================
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // ================================================================================
    // nf-core modules (FastQC, MultiQC)
    // ================================================================================

    withName: 'FASTQC' {
        ext.args   = '--quiet'
        publishDir = [
            path: { "${params.outdir}/QC_statistics/per_sample/fastqc/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/QC_statistics/cohort/multiqc/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ================================================================================
    // Validation & QC
    // ================================================================================

    withName: 'SAMPLESHEET_VALIDATION' {
        publishDir = [
            path: { "${params.outdir}/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
        errorStrategy = 'terminate'
    }

    withName: 'FASTQ_VALIDATOR' {
        publishDir = [
            path: { "${params.outdir}/QC_statistics/per_sample/fastq_validation/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'UTILS_FASTQ_COHORT_VALIDATION' {
        publishDir = [
            path: { "${params.outdir}/QC_statistics/cohort/fastq_validation/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'UTILS_MULTIPLE_INFECTION_FILTER' {
        publishDir = [
            path: { "${params.outdir}/QC_statistics/cohort/multiple_infection_filter" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    // ================================================================================
    // Mapping — BWA + SAMTOOLS_SORT
    // ================================================================================

    withName: 'BWA_MEM' {
        // -k 100: ~2/3 of typical Mtb read length for optimal contaminant removal
        ext.args  = '-M'
        ext.args2 = '-k 100'
        publishDir = [
            path: { "${params.outdir}/extra/per_sample/mapped_sequences/mapped_libraries/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'BWA_MEM_DELLY' {
        // Default -k 19 for DELLY-compatible alignments
        ext.args  = '-M'
        ext.args2 = ''
        publishDir = [
            path: { "${params.outdir}/extra/per_sample/mapped_sequences/mapped_libraries/delly/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    // ================================================================================
    // SAMTOOLS merge / index / stats
    // ================================================================================

    withName: 'SAMTOOLS_MERGE.*' {
        // -f (force-overwrite) was hardcoded in the local module's script;
        // nf-core uses ext.args. Same MAGMA filename pattern reproduced via
        // ext.prefix (nf-core appends .${file_type} for the extension).
        ext.args   = '-f'
        ext.prefix = { "${meta.id}.sorted_reads" }
    }

    withName: 'SAMTOOLS_MERGE' {
        publishDir = [
            path: { "${params.outdir}/extra/per_sample/mapped_sequences/merged_libraries/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'SAMTOOLS_MERGE_DELLY' {
        publishDir = [
            path: { "${params.outdir}/extra/per_sample/mapped_sequences/merged_libraries/delly/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'SAMTOOLS_INDEX' {
        publishDir = [
            path: { "${params.outdir}/extra/per_sample/mapped_sequences/marked_duplicates/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'SAMTOOLS_INDEX_DELLY' {
        publishDir = [
            path: { "${params.outdir}/extra/per_sample/mapped_sequences/marked_duplicates/delly/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'SAMTOOLS_INDEX_LOFREQ' {
        publishDir = [
            path: { "${params.outdir}/vcf_files/per_sample/minor_variants/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'SAMTOOLS_STATS' {
        ext.args   = '-F DUP,SUPPLEMENTARY,SECONDARY,UNMAP,QCFAIL'
        // Reproduce the MAGMA filename pattern so published outputs stay
        // grep-able as <sample>.SamtoolStats.* (nf-core appends `.stats`).
        ext.prefix = { "${meta.id}.SamtoolStats" }
        publishDir = [
            path: { "${params.outdir}/QC_statistics/per_sample/mapping/" },
            mode: params.publish_dir_mode,
        ]
    }

    // ================================================================================
    // GATK per-sample
    // ================================================================================

    withName: 'GATK_MARK_DUPLICATES' {
        // nf-core gatk4/markduplicates uses ext.prefix as the OUTPUT BAM filename
        // (including its .bam extension; default prefix is '${meta.id}.bam'). We
        // set it to '${meta.id}.dedup_reads.bam' to preserve MAGMA's filename
        // pattern. The metrics file becomes '${prefix}.metrics' →
        // '${meta.id}.dedup_reads.bam.metrics' (was '${meta.id}.MarkDupMetrics.txt')
        // — metrics is publish-only and not consumed downstream, so the rename
        // is harmless.
        ext.prefix = { "${meta.id}.dedup_reads.bam" }
        publishDir = [
            path: { "${params.outdir}/extra/per_sample/mapped_sequences/marked_duplicates/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'GATK_MARK_DUPLICATES_DELLY' {
        ext.prefix = { "${meta.id}.dedup_reads.bam" }
        publishDir = [
            path: { "${params.outdir}/extra/per_sample/mapped_sequences/marked_duplicates/delly/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'GATK_BASE_RECALIBRATOR' {
        publishDir = [
            path: { "${params.outdir}/extra/per_sample/mapped_sequences/base_recalibrated/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'GATK_BASE_RECALIBRATOR_DELLY' {
        publishDir = [
            path: { "${params.outdir}/extra/per_sample/mapped_sequences/base_recalibrated/delly/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'GATK_APPLY_BQSR.*' {
        // nf-core gatk4/applybqsr defaults to CRAM output; force BAM to keep
        // the MAGMA chain (which always operates on BAM downstream) intact.
        ext.suffix = 'bam'
        // Preserve the MAGMA filename pattern: ${meta.id}.baserecalibrated.bam.
        ext.prefix = { "${meta.id}.baserecalibrated" }
    }

    withName: 'GATK_APPLY_BQSR' {
        publishDir = [
            path: { "${params.outdir}/extra/per_sample/mapped_sequences/base_recalibrated/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'GATK_APPLY_BQSR_DELLY' {
        publishDir = [
            path: { "${params.outdir}/extra/per_sample/mapped_sequences/base_recalibrated/delly/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'GATK_HAPLOTYPE_CALLER' {
        // The local module hardcoded -ERC GVCF + -bamout in its script; nf-core
        // doesn't, so they move into ext.args. -bamout writes the realigned BAM
        // to a custom filename matching MAGMA's pattern (nf-core would name it
        // <prefix-stripped-of-.g>.realigned.bam — we want .haplotype_caller.bam).
        ext.args = { "-ERC GVCF -ploidy 1 --dont-use-soft-clipped-bases --read-filter MappingQualityNotZeroReadFilter -G StandardAnnotation -G AS_StandardAnnotation --bam-output ${meta.id}.haplotype_caller.bam" }
        // VCF filename ${meta.id}.g.vcf.gz (nf-core appends .vcf.gz to prefix).
        ext.prefix = { "${meta.id}.g" }
        publishDir = [
            [
                path: { "${params.outdir}/extra/per_sample/major_variants/haplotype_caller/" },
                mode: params.publish_dir_mode,
                pattern: "*vcf*",
                enabled: false
            ],
            [
                path: { "${params.outdir}/extra/per_sample/major_variants/haplotype_caller/" },
                mode: params.publish_dir_mode,
                pattern: "*bam*",
                enabled: { params.magma_should_publish_bam }
            ]
        ]
    }

    withName: 'GATK_HAPLOTYPE_CALLER_MINOR_VARIANTS' {
        ext.args = """-ploidy 1 \
            --minimum-mapping-quality 60 \
            --min-base-quality-score 20 \
            --read-filter MappingQualityNotZeroReadFilter \
            -G StandardAnnotation \
            --dont-use-soft-clipped-bases \
            --output-mode EMIT_ALL_ACTIVE_SITES"""
        ext.when = { !params.magma_skip_minor_variants_gatk }
        publishDir = [
            path: { "${params.outdir}/extra/per_sample/minor_variants/haplotype_caller/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'GATK_COLLECT_WGS_METRICS' {
        ext.args = '--READ_LENGTH 0 --COVERAGE_CAP 10000 --COUNT_UNPAIRED'
        publishDir = [
            path: { "${params.outdir}/QC_statistics/per_sample/coverage/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'GATK_FLAG_STAT' {
        publishDir = [
            path: { "${params.outdir}/QC_statistics/per_sample/mapping/" },
            mode: params.publish_dir_mode,
        ]
    }

    // ================================================================================
    // LoFreq minor-variant calling
    // ================================================================================

    withName: 'LOFREQ_INDELQUAL' {
        // torch-magma's default_params set arguments="-m 60" here, but its
        // indelqual module never interpolated them (dead config) — and
        // `lofreq indelqual` rejects -m ("invalid option -- 'm'"). The actual
        // torch-magma command was: lofreq indelqual -f … --dindel -o … <bam>.
        // The nf-core module template puts ${args} before the other flags, so
        // the emitted command becomes
        //   lofreq indelqual --dindel -f … -o ${meta.id}.dindel.bam <bam>
        // which differs from the reference only in flag order (cosmetic).
        ext.args   = '--dindel'
        ext.prefix = { "${meta.id}.dindel" }
        publishDir = [
            path: { "${params.outdir}/vcf_files/per_sample/minor_variants/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'LOFREQ_CALL' {
        ext.args = '-m 60 --call-indels -Q 30'
        publishDir = [
            path: { "${params.outdir}/vcf_files/per_sample/minor_variants/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'LOFREQ_CALL_NTM' {
        ext.args   = '-m 60 -Q 20 -a 1'
        ext.args2  = '1472307-1472307'  // region
        publishDir = [
            path: { "${params.outdir}/non-tuberculous_mycobacteria/vcf_files/variants/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'LOFREQ_FILTER' {
        ext.args   = '-a 0.20'
        // Preserve the MAGMA filename pattern. nf-core's module hardcodes
        // output to ${prefix}.vcf.gz, so the published artifact becomes
        // ${meta.id}.Filtered_AF.vcf.gz (was ${meta.id}.Filtered_AF.vcf,
        // uncompressed). LOFREQ_FILTER.out is publish-only — the downstream
        // UTILS_REFORMAT_LOFREQ chain consumes the RAW LOFREQ_CALL output,
        // not this filtered one — so the format change is purely cosmetic.
        ext.prefix = { "${meta.id}.Filtered_AF" }
        publishDir = [
            path: { "${params.outdir}/vcf_files/per_sample/minor_variants/" },
            mode: params.publish_dir_mode,
        ]
    }

    // ================================================================================
    // DELLY structural variants
    // ================================================================================

    withName: 'DELLY_CALL' {
        // torch-magma reference: delly call -g <ref> <bam> -u 30 -o <sample>.delly.bcf
        // nf-core after migration (suffix='bcf'):
        //   delly call -u 30 --threads <cpus> --outfile <sample>.delly.bcf --genome <ref> <bam>
        // Differences are cosmetic — long-form --genome / --outfile vs -g / -o,
        // plus the added --threads flag — but the underlying delly invocation
        // (discovery mode, -u 30) produces the same BCF output.
        ext.args   = '-u 30'
        ext.prefix = { "${meta.id}.delly" }
        publishDir = [
            path: { "${params.outdir}/vcf_files/per_sample/structural_variants/delly/" },
            mode: params.publish_dir_mode,
        ]
    }

    // ================================================================================
    // NTM profiler
    // ================================================================================

    withName: 'NTMPROFILER_PROFILE' {
        ext.when = { !params.magma_skip_ntmprofiler }
        publishDir = [
            path: { "${params.outdir}/analyses/non-tuberculous_mycobacteria/per_sample/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'NTMPROFILER_COLLATE' {
        ext.prefix = 'ntmprofiler.collate'
        ext.when   = { !params.magma_skip_ntmprofiler }
        publishDir = [
            path: { "${params.outdir}/analyses/non-tuberculous_mycobacteria/cohort/" },
            mode: params.publish_dir_mode,
        ]
    }

    // ================================================================================
    // BCFtools filtering for SV annotation
    // ================================================================================

    withName: 'BCFTOOLS_VIEW_ISMAPPER' {
        publishDir = [
            path: { "${params.outdir}/vcf_files/per_sample/structural_variants/ismapper/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'BCFTOOLS_VIEW_GATK' {
        publishDir = [
            path: { "${params.outdir}/vcf_files/per_sample/structural_variants/gatk/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'BCFTOOLS_VIEW_DELLY' {
        // Local module ran 3 commands (view → bgzip → bcftools index). nf-core
        // does it in one call via `-Ob` (bgzipped BCF output) and
        // `--write-index=csi` (auto-create the index). Filename pattern
        // ${meta.id}.filtered.bcf.gz reproduced via ext.prefix + the .bcf.gz
        // suffix nf-core adds for -Ob.
        ext.args   = """-i 'GT="1/1"' -Ob --write-index=csi"""
        ext.prefix = { "${meta.id}.filtered" }
        publishDir = [
            path: { "${params.outdir}/vcf_files/per_sample/structural_variants/delly/" },
            mode: params.publish_dir_mode,
        ]
    }

    // ================================================================================
    // GATK index / select variants (per-sample SV)
    // ================================================================================

    withName: 'GATK_INDEX_FEATURE_FILE_SV' {
        publishDir = [
            path: { "${params.outdir}/vcf_files/per_sample/structural_variants/delly/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'GATK_SELECT_VARIANTS_INCLUSION' {
        publishDir = [
            path: { "${params.outdir}/vcf_files/per_sample/structural_variants/delly/" },
            mode: params.publish_dir_mode,
        ]
    }

    // ================================================================================
    // ISMapper
    // ================================================================================

    withName: 'ISMAPPER' {
        ext.when = { !params.magma_skip_ismapper }
        publishDir = [
            path: { "${params.outdir}/vcf_files/per_sample/structural_variants/ismapper/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    // ================================================================================
    // QC statistics utils
    // ================================================================================

    withName: 'UTILS_SAMPLE_STATS' {
        publishDir = [
            path: { "${params.outdir}/QC_statistics/samples_thresholds/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'UTILS_COHORT_STATS' {
        publishDir = [
            path: { "${params.outdir}/QC_statistics/cohort/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'UTILS_MERGE_COHORT_STATS' {
        publishDir = [
            path: { "${params.outdir}/QC_statistics/cohort/" },
            mode: params.publish_dir_mode,
        ]
    }

    // ================================================================================
    // Cohort — GATK joint genotyping
    // ================================================================================

    withName: 'GATK_COMBINE_GVCFS' {
        ext.args = '-G StandardAnnotation -G AS_StandardAnnotation'
        publishDir = [
            path: { "${params.outdir}/vcf_files/cohort/raw_variant_files/combined/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'GATK_GENOTYPE_GVCFS' {
        ext.args   = '-G StandardAnnotation -G AS_StandardAnnotation --sample-ploidy 1'
        // Preserve MAGMA filename ${joint}.raw_variants.vcf.gz.
        ext.prefix = { "${meta.id}.raw_variants" }
        publishDir = [
            path: { "${params.outdir}/vcf_files/cohort/raw_variant_files/genotyped/" },
            mode: params.publish_dir_mode,
        ]
    }

    // ================================================================================
    // SnpEff annotation
    // ================================================================================

    withName: 'SNPEFF' {
        ext.args = { "-nostats -ud 100 ${params.magma_snpeff_genome_id}" }
        publishDir = [
            path: { "${params.outdir}/vcf_files/cohort/raw_variant_files/annotated/" },
            mode: params.publish_dir_mode,
        ]
    }

    // ================================================================================
    // BGzip
    // ================================================================================

    withName: 'BGZIP' {
        publishDir = [
            path: { "${params.outdir}/vcf_files/cohort/raw_variant_files/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'BGZIP_LOFREQ' {
        ext.args = '-f'
        publishDir = [
            path: { "${params.outdir}/vcf_files/per_sample/minor_variants/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'BGZIP_MINOR_VARIANTS' {
        ext.args = '-f'
        publishDir = [
            path: { "${params.outdir}/vcf_files/cohort/minor_variants/combined_variant_files/" },
            mode: params.publish_dir_mode,
        ]
    }

    // ================================================================================
    // LoFreq / minor-variant reformat
    // ================================================================================

    withName: 'UTILS_REFORMAT_LOFREQ' {
        publishDir = [
            path: { "${params.outdir}/vcf_files/per_sample/minor_variants/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'GATK_INDEX_FEATURE_FILE_LOFREQ' {
        // Match standard MAGMA: emit explicit `-O <vcf>.tbi` (minor-variants path).
        // Input vcf is ${meta.id}.lofreq.reformat.corrected.vcf.gz.
        ext.args   = { "-O ${meta.id}.lofreq.reformat.corrected.vcf.gz.tbi" }
        publishDir = [
            path: { "${params.outdir}/vcf_files/per_sample/minor_variants/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'GATK_INDEX_FEATURE_FILE_COHORT' {
        publishDir = [
            path: { "${params.outdir}/vcf_files/cohort/raw_variant_files/" },
            mode: params.publish_dir_mode,
        ]
    }

    // ================================================================================
    // GATK SelectVariants — cohort
    // ================================================================================

    withName: 'GATK_SELECT_VARIANTS_SNP' {
        // The local module took variantType='SNP' and prefix='raw' as positional
        // val inputs; nf-core uses ext.args / ext.prefix. --select-type-to-include
        // SNP appended explicitly here. Output filename joint.raw_SNP.vcf.gz.
        ext.args   = '--select-type-to-include SNP --remove-unused-alternates --exclude-non-variants'
        ext.prefix = { "${meta.id}.raw_SNP" }
        publishDir = [
            path: { "${params.outdir}/vcf_files/cohort/snp_variant_files/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'GATK_SELECT_VARIANTS_INDEL' {
        // Same migration pattern as SNP. Output filename joint.raw_INDEL.vcf.gz.
        ext.args   = '--select-type-to-include INDEL --remove-unused-alternates --exclude-non-variants --select-type-to-include MNP --select-type-to-include MIXED'
        ext.prefix = { "${meta.id}.raw_INDEL" }
        publishDir = [
            path: { "${params.outdir}/vcf_files/cohort/indel_variant_files/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'GATK_SELECT_VARIANTS_EXCLUSION_SNP' {
        publishDir = [
            path: { "${params.outdir}/vcf_files/cohort/snp_variant_files/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'GATK_SELECT_VARIANTS_EXCLUSION_INDEL' {
        ext.args = '--select-type-to-include MNP --select-type-to-include MIXED'
        publishDir = [
            path: { "${params.outdir}/vcf_files/cohort/indel_variant_files/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'GATK_SELECT_VARIANTS_PHYLOGENY' {
        ext.args = '--remove-unused-alternates --exclude-non-variants'
        publishDir = [
            path: { "${params.outdir}/analyses/phylogeny/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    // ================================================================================
    // GATK VQSR
    // ================================================================================

    withName: 'GATK_VARIANT_RECALIBRATOR_SNP' {
        ext.prefix = 'SNP'
        ext.args = """--use-allele-specific-annotations \
            -AS \
            --target-titv 1.7 \
            --truth-sensitivity-tranche 100.0 \
            --truth-sensitivity-tranche 99.9 \
            --truth-sensitivity-tranche 99.8 \
            --truth-sensitivity-tranche 99.7 \
            --truth-sensitivity-tranche 99.6 \
            --truth-sensitivity-tranche 99.5 \
            --truth-sensitivity-tranche 99.4 \
            --truth-sensitivity-tranche 99.3 \
            --truth-sensitivity-tranche 99.2 \
            --truth-sensitivity-tranche 99.1 \
            --truth-sensitivity-tranche 99.0 \
            --max-gaussians 4 \
            -mq-cap 60"""
        ext.when = { !params.magma_skip_variant_recalibration }
        publishDir = [
            path: { "${params.outdir}/vcf_files/cohort/snp_variant_files/vqsr/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'GATK_VARIANT_RECALIBRATOR_INDEL' {
        ext.prefix = 'INDEL'
        ext.args = """-AS \
            --target-titv 1.8 \
            --truth-sensitivity-tranche 100.0 \
            --truth-sensitivity-tranche 99.9 \
            --truth-sensitivity-tranche 99.8 \
            --truth-sensitivity-tranche 99.7 \
            --truth-sensitivity-tranche 99.6 \
            --truth-sensitivity-tranche 99.5 \
            --truth-sensitivity-tranche 99.4 \
            --truth-sensitivity-tranche 99.3 \
            --truth-sensitivity-tranche 99.2 \
            --truth-sensitivity-tranche 99.1 \
            --truth-sensitivity-tranche 99.0 \
            --max-gaussians 4 \
            -mq-cap 60"""
        ext.when = { !params.magma_skip_variant_recalibration }
        publishDir = [
            path: { "${params.outdir}/vcf_files/cohort/indel_variant_files/vqsr/" },
            mode: params.publish_dir_mode,
        ]
    }

    // VQSR annotation-optimization variants (ANN2–ANN7) — used by optimize_variant_recalibration subworkflow.
    //
    // Shared SNP-VQSR args: the OPTIMIZE_VARIANT_RECALIBRATION subworkflow drives
    // GATK_VARIANT_RECALIBRATOR over 6 annotation combinations (ANN7 → ... → ANN2)
    // in mode=SNP. Without these flags the gatk call dies with
    //   java.lang.ClassCastException: java.util.ArrayList cannot be cast to java.lang.String
    //   at htsjdk.variant.variantcontext.CommonInfo.getAttributeAsDouble
    // because AS_QD / AS_MQ / AS_FS / AS_SOR / AS_MQRankSum / AS_ReadPosRankSum
    // are per-allele lists and require --use-allele-specific-annotations / -AS to
    // be parsed. This matches torch-magma's reference command exactly. The
    // per-alias blocks below only carry prefix / publishDir; this block carries
    // the args (multiple matching withName blocks compose in Nextflow).
    withName: 'GATK_VARIANT_RECALIBRATOR_ANN[2-7]' {
        ext.args = """--use-allele-specific-annotations \
            -AS \
            --target-titv 1.7 \
            --truth-sensitivity-tranche 100.0 \
            --truth-sensitivity-tranche 99.9 \
            --truth-sensitivity-tranche 99.8 \
            --truth-sensitivity-tranche 99.7 \
            --truth-sensitivity-tranche 99.6 \
            --truth-sensitivity-tranche 99.5 \
            --truth-sensitivity-tranche 99.4 \
            --truth-sensitivity-tranche 99.3 \
            --truth-sensitivity-tranche 99.2 \
            --truth-sensitivity-tranche 99.1 \
            --truth-sensitivity-tranche 99.0 \
            --max-gaussians 4 \
            -mq-cap 60"""
    }

    withName: 'GATK_VARIANT_RECALIBRATOR_ANN2' {
        ext.prefix = 'ANN2'
        ext.when = { !params.magma_skip_variant_recalibration }
        publishDir = [ path: { "${params.outdir}/vcf_files/cohort/snp_variant_files/vqsr__ann2/" }, mode: params.publish_dir_mode ]
    }
    withName: 'GATK_VARIANT_RECALIBRATOR_ANN3' {
        ext.prefix = 'ANN3'
        ext.when = { !params.magma_skip_variant_recalibration }
        publishDir = [ path: { "${params.outdir}/vcf_files/cohort/snp_variant_files/vqsr__ann3/" }, mode: params.publish_dir_mode ]
    }
    withName: 'GATK_VARIANT_RECALIBRATOR_ANN4' {
        ext.prefix = 'ANN4'
        ext.when = { !params.magma_skip_variant_recalibration }
        publishDir = [ path: { "${params.outdir}/vcf_files/cohort/snp_variant_files/vqsr__ann4/" }, mode: params.publish_dir_mode ]
    }
    withName: 'GATK_VARIANT_RECALIBRATOR_ANN5' {
        ext.prefix = 'ANN5'
        ext.when = { !params.magma_skip_variant_recalibration }
        publishDir = [ path: { "${params.outdir}/vcf_files/cohort/snp_variant_files/vqsr__ann5/" }, mode: params.publish_dir_mode ]
    }
    withName: 'GATK_VARIANT_RECALIBRATOR_ANN6' {
        ext.prefix = 'ANN6'
        ext.when = { !params.magma_skip_variant_recalibration }
        publishDir = [ path: { "${params.outdir}/vcf_files/cohort/snp_variant_files/vqsr__ann6/" }, mode: params.publish_dir_mode ]
    }
    withName: 'GATK_VARIANT_RECALIBRATOR_ANN7' {
        ext.prefix = 'ANN7'
        ext.when = { !params.magma_skip_variant_recalibration }
        publishDir = [ path: { "${params.outdir}/vcf_files/cohort/snp_variant_files/vqsr__ann7/" }, mode: params.publish_dir_mode ]
    }

    withName: 'GATK_APPLY_VQSR_SNP' {
        // -mode SNP is appended to ext.args (was a positional val(analysisMode)
        // input on the local module — nf-core uses ext.args).
        // ext.prefix preserves the MAGMA filename pattern.
        ext.args   = '--ts-filter-level 99.90 -AS --exclude-filtered -mode SNP'
        ext.prefix = { "${meta.id}.filtered_SNP_inc-rRNA" }
        ext.when   = { !params.magma_skip_variant_recalibration }
        publishDir = [
            path: { "${params.outdir}/vcf_files/cohort/snp_variant_files/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'GATK_APPLY_VQSR_INDEL' {
        ext.when = { !params.magma_skip_variant_recalibration }
        publishDir = [
            path: { "${params.outdir}/vcf_files/cohort/indel_variant_files/" },
            mode: params.publish_dir_mode,
        ]
    }

    // VQSR annotation filtering (used by optimize_variant_recalibration subworkflow)
    withName: 'UTILS_ELIMINATE_ANNOTATION_ANN2' {
        ext.prefix = 'ANN2'
        ext.when = { !params.magma_skip_variant_recalibration }
        publishDir = [ path: { "${params.outdir}/vcf_files/cohort/snp_variant_files/vqsr__ann2/" }, mode: params.publish_dir_mode ]
    }
    withName: 'UTILS_ELIMINATE_ANNOTATION_ANN3' {
        ext.prefix = 'ANN3'
        ext.when = { !params.magma_skip_variant_recalibration }
        publishDir = [ path: { "${params.outdir}/vcf_files/cohort/snp_variant_files/vqsr__ann3/" }, mode: params.publish_dir_mode ]
    }
    withName: 'UTILS_ELIMINATE_ANNOTATION_ANN4' {
        ext.prefix = 'ANN4'
        ext.when = { !params.magma_skip_variant_recalibration }
        publishDir = [ path: { "${params.outdir}/vcf_files/cohort/snp_variant_files/vqsr__ann4/" }, mode: params.publish_dir_mode ]
    }
    withName: 'UTILS_ELIMINATE_ANNOTATION_ANN5' {
        ext.prefix = 'ANN5'
        ext.when = { !params.magma_skip_variant_recalibration }
        publishDir = [ path: { "${params.outdir}/vcf_files/cohort/snp_variant_files/vqsr__ann5/" }, mode: params.publish_dir_mode ]
    }
    withName: 'UTILS_ELIMINATE_ANNOTATION_ANN6' {
        ext.prefix = 'ANN6'
        ext.when = { !params.magma_skip_variant_recalibration }
        publishDir = [ path: { "${params.outdir}/vcf_files/cohort/snp_variant_files/vqsr__ann6/" }, mode: params.publish_dir_mode ]
    }
    withName: 'UTILS_ELIMINATE_ANNOTATION_ANN7' {
        ext.prefix = 'ANN7'
        ext.when = { !params.magma_skip_variant_recalibration }
        publishDir = [ path: { "${params.outdir}/vcf_files/cohort/snp_variant_files/vqsr__ann7/" }, mode: params.publish_dir_mode ]
    }

    withName: 'UTILS_SELECT_BEST_ANNOTATIONS' {
        ext.when = { !params.magma_skip_variant_recalibration }
        publishDir = [
            path: { "${params.outdir}/vcf_files/cohort/snp_variant_files/vqsr/best_annotations/" },
            mode: params.publish_dir_mode,
        ]
    }

    // ================================================================================
    // BCFtools merge (cohort)
    // ================================================================================

    withName: 'BCFTOOLS_MERGE_LOFREQ' {
        publishDir = [
            path: { "${params.outdir}/vcf_files/cohort/minor_variants/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'BCFTOOLS_MERGE_DELLY' {
        publishDir = [
            path: { "${params.outdir}/vcf_files/cohort/structural_variants/" },
            mode: params.publish_dir_mode,
        ]
    }

    // ================================================================================
    // GATK MergeVcfs
    // ================================================================================

    withName: 'GATK_MERGE_VCFS.*' {
        // Reproduce MAGMA filename: ${joint}.filtered_SNP.RawIndels.vcf.gz.
        // The nf-core gatk4/mergevcfs module emits ${prefix}.vcf.gz; we set
        // ext.prefix to include the MAGMA-specific suffix.
        ext.prefix = { "${meta.id}.filtered_SNP.RawIndels" }
        publishDir = [
            path: { "${params.outdir}/vcf_files/cohort/major_variants/" },
            mode: params.publish_dir_mode,
        ]
    }

    // ================================================================================
    // GATK VariantsToTable
    // ================================================================================

    withName: 'GATK_VARIANTS_TO_TABLE' {
        ext.args = '-GF GT'
        publishDir = [
            path: { "${params.outdir}/vcf_files/cohort/multiple_alignment_files/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    // ================================================================================
    // TBprofiler
    // ================================================================================

    withName: 'TBPROFILER_VCF_PROFILE_COHORT' {
        ext.args = '--depth 0,0 --af 0,0 --strand 0 --sv_depth 0,0 --sv_af 0,0 --sv_len 100000,50000'
        publishDir = [
            path: { "${params.outdir}/analyses/drug_resistance/major_variants_xbs/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'TBPROFILER_COLLATE_COHORT' {
        ext.prefix = 'major_variants'
        publishDir = [
            path: { "${params.outdir}/analyses/drug_resistance/major_variants_xbs/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'TBPROFILER_FASTQ_PROFILE' {
        ext.args = '--csv'
        ext.when = { !params.magma_skip_tbprofiler_fastq }
        publishDir = [
            path: { "${params.outdir}/analyses/others/per_sample/tbprofiler_fastq/" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'TBPROFILER_FASTQ_COLLATE' {
        ext.prefix = 'fastq'
        ext.when   = { !params.magma_skip_tbprofiler_fastq }
        publishDir = [
            path: { "${params.outdir}/analyses/drug_resistance/tbprofiler_fastq/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'TBPROFILER_VCF_PROFILE_LOFREQ' {
        ext.args = '--depth 0,0 --af 0,0 --strand 0 --sv_depth 0,0 --sv_af 0,0 --sv_len 100000,50000'
        publishDir = [
            path: { "${params.outdir}/analyses/drug_resistance/minor_variants_lofreq/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'TBPROFILER_COLLATE_LOFREQ' {
        ext.prefix = 'minor_variants'
        publishDir = [
            path: { "${params.outdir}/analyses/drug_resistance/minor_variants_lofreq/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'TBPROFILER_VCF_PROFILE_DELLY' {
        ext.args = '--depth 0,0 --af 0,0 --strand 0 --sv_depth 0,0 --sv_af 0,0 --sv_len 100000,50000'
        publishDir = [
            path: { "${params.outdir}/analyses/drug_resistance/structural_variants_delly/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'TBPROFILER_COLLATE_DELLY' {
        ext.prefix = 'structural_variants'
        publishDir = [
            path: { "${params.outdir}/analyses/drug_resistance/structural_variants_delly/" },
            mode: params.publish_dir_mode,
        ]
    }

    // ================================================================================
    // SpoTyping
    // ================================================================================

    withName: 'SPOTYPING' {
        ext.when = { !params.magma_skip_spotyping }
        publishDir = [
            path: { "${params.outdir}/analyses/spotyping/results_excel/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'UTILS_CAT_SPOTYPING' {
        ext.when = { !params.magma_skip_spotyping }
        publishDir = [
            path: { "${params.outdir}/analyses/spotyping/" },
            mode: params.publish_dir_mode,
        ]
    }

    // ================================================================================
    // RDAnalyzer
    // ================================================================================

    withName: 'RDANALYZER' {
        ext.when = { !params.magma_skip_rdanalyzer }
        publishDir = [
            path: { "${params.outdir}/analyses/others/per_sample/rdanalyzer/" },
            mode: params.publish_dir_mode,
        ]
    }

    // ================================================================================
    // Phylogeny & clustering
    // ================================================================================

    withName: 'SNPSITES' {
        publishDir = [
            path: { "${params.outdir}/vcf_files/cohort/multiple_alignment_files/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'SNPDISTS' {
        // Drive the nf-core SNPDISTS module to emit the same scientific output
        // as torch-magma's local snp-dists wrapper:
        //   torch-magma:   `snp-dists joint.variable.<prefix>.fa -b > joint.<prefix>.snp_dists.tsv`
        //   port (nf-core): `snp-dists -b joint.variable.<prefix>.fa > joint.<prefix>.snp_dists.tsv`
        // Arg order (-b before vs after the alignment) is cosmetic — snp-dists
        // is order-insensitive and the output file is byte-identical.
        ext.args   = '-b'
        ext.prefix = { "${meta.id}.${meta.phylo_prefix}.snp_dists" }
        publishDir = [
            path: { "${params.outdir}/analyses/snp_distances/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'IQTREE' {
        // NOTE: arguments are decided within the process based on iqtree_* params
        publishDir = [
            path: { "${params.outdir}/analyses/phylogeny/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'CLUSTERPICKER' {
        ext.args = [
            '0',       // bootstrap_1
            '0',       // bootstrap_2
            '0',       // max_cluster_size
            'gap'      // algorithm
        ].join(' ')
        publishDir = [
            path: { "${params.outdir}/analyses/cluster_analysis/" },
            mode: params.publish_dir_mode,
        ]
    }

    // ================================================================================
    // Resistance summary utils
    // ================================================================================

    withName: 'UTILS_SUMMARIZE_RESISTANCE_RESULTS' {
        publishDir = [
            path: { "${params.outdir}/analyses/drug_resistance/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'UTILS_SUMMARIZE_RESISTANCE_RESULTS_MIXED_INFECTION' {
        publishDir = [
            path: { "${params.outdir}/analyses/drug_resistance/" },
            mode: params.publish_dir_mode,
        ]
    }

}
