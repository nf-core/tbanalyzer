/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    MAGMA mode container assignments  (vendored from MAGMA v0.3.0 conf/abc_cluster.config)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    MAGMA's local modules (python utils + tool wrappers) carry no container
    directive of their own — they rely on these per-process-name assignments.
    Required on any containerised executor (Docker / Nomad); without them a
    process like SAMPLESHEET_VALIDATION fails with "Missing container image".
    Mirrors MAGMA's validated container layout (magma-container-1/2 + the
    per-tool biocontainers), including the functional DELLY/BCFTOOLS overrides
    where magma-container's bundled tool is too old for the nf-core command.
----------------------------------------------------------------------------------------
*/

process {

    withName: '.*SPOTYPING.*'  { container = "quay.io/biocontainers/spotyping:2.1--hdfd78af_4" }
    withName: '.*RDANALYZER.*' { container = "quay.io/biocontainers/rd-analyzer:1.01--hdfd78af_0" }
    withName: '.*TBPROFILER.*' { container = "ghcr.io/torch-consortium/magma/biocontainer-tbprofiler:6.3.0--1" }
    withName: 'NTMPROFILER.*'  { container = "ghcr.io/torch-consortium/magma/biocontainer-ntmprofiler:0.4.0" }
    withName: 'ISMAPPER.*|GATK.*|LOFREQ.*|DELLY.*|MULTIQC.*|FASTQC.*|UTILS.*|FASTQ.*|SAMPLESHEET.*' {
        container = "ghcr.io/torch-consortium/magma/magma-container-1:2.0.0"
    }
    withName: 'BWA.*|IQTREE.*|SNPDISTS.*|SNPSITES.*|BCFTOOLS.*|BGZIP.*|SAMTOOLS.*|SNPEFF.*|CLUSTERPICKER.*' {
        container = "ghcr.io/torch-consortium/magma/magma-container-2:1.1.1"
    }

    // Functional container overrides: the nf-core delly/call + bcftools/view
    // module commands use flags newer than the tools bundled in magma-container.
    withName: '.*DELLY_CALL.*'    { container = 'quay.io/biocontainers/delly:1.7.3--hd6466ae_0' }
    withName: '.*BCFTOOLS_VIEW.*' { container = 'quay.io/biocontainers/bcftools:1.21--h3a4d415_1' }
}
