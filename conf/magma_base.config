/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    MAGMA mode default parameters  (pinned to MAGMA v0.3.0 / f33a913)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Loaded when params.mode == 'magma'. References bundled under
    data/magma-references/ (vendored from mycobactopia-org/MAGMA tag v0.3.0).
----------------------------------------------------------------------------------------
*/

params {
    magma_input_samplesheet          = null     // backward-compat alias; prefer --input
    magma_vcf_name                   = 'joint'
    magma_use_ref_gvcf               = true
    magma_ref_gvcf                   = "${projectDir}/data/magma-references/ref_gvcfs/LineagesAndOutgroupV2.g.vcf.gz"
    magma_ref_gvcf_tbi               = "${projectDir}/data/magma-references/ref_gvcfs/LineagesAndOutgroupV2.g.vcf.gz.tbi"
    magma_cutoff_median_coverage     = 10
    magma_cutoff_breadth_of_coverage = 0.90
    magma_cutoff_rel_abundance       = 0.70
    magma_cutoff_ntm_fraction        = 0.20
    magma_cutoff_site_representation = 0.95
    magma_cutoff_strand_bias         = 0         // 0 = skip strand-bias filter
    magma_only_validate_fastqs            = false
    magma_skip_merge_analysis             = false
    magma_skip_variant_recalibration      = false  // VQSR optimisation
    magma_skip_base_recalibration         = true   // BQSR — not recommended for Mtb
    magma_skip_minor_variants_gatk        = true   // LoFreq preferred
    magma_skip_phylogeny_and_clustering   = false
    magma_skip_complex_regions            = false
    magma_skip_ntmprofiler                = false
    magma_skip_tbprofiler_fastq           = true
    magma_skip_spotyping                  = true
    magma_skip_rdanalyzer                 = true   // experimental, not production-ready
    magma_skip_ismapper                   = false
    magma_iqtree_standard_bootstrap           = true
    magma_iqtree_fast_ml_only                 = false
    magma_iqtree_fast_bootstrapped_phylogeny  = false
    magma_iqtree_accurate_ml_only             = false
    magma_ref_fasta_basename         = "NC-000962-3-H37Rv"
    magma_ref_fasta_dir              = "${projectDir}/data/magma-references/genome"
    magma_ref_fasta                  = "${params.magma_ref_fasta_dir}/${params.magma_ref_fasta_basename}.fa"
    magma_ref_fasta_gb               = "${params.magma_ref_fasta_dir}/${params.magma_ref_fasta_basename}.gb"
    magma_ref_fasta_dict             = "${params.magma_ref_fasta_dir}/${params.magma_ref_fasta_basename}.dict"
    magma_ref_fasta_amb              = "${params.magma_ref_fasta}.amb"
    magma_ref_fasta_ann              = "${params.magma_ref_fasta}.ann"
    magma_ref_fasta_bwt              = "${params.magma_ref_fasta}.bwt"
    magma_ref_fasta_fai              = "${params.magma_ref_fasta}.fai"
    magma_ref_fasta_pac              = "${params.magma_ref_fasta}.pac"
    magma_ref_fasta_sa               = "${params.magma_ref_fasta}.sa"
    magma_queries_multifasta         = "${projectDir}/data/magma-references/regions/IS_Queries_Mtb.multi.fasta"
    magma_drgenes_list               = "${projectDir}/data/magma-references/regions/WHO_Tier1_Tier2_DR.list"
    magma_rrna_list                  = "${projectDir}/data/magma-references/regions/rRNA.list"
    magma_excluded_loci_list         = "${projectDir}/data/magma-references/regions/UVP_List_of_Excluded_loci.list"
    magma_dbsnp_vcf                  = "${projectDir}/data/magma-references/known/Benavente2015.UVPapproved.rRNAexcluded.vcf.gz"
    magma_dbsnp_vcf_tbi              = "${params.magma_dbsnp_vcf}.tbi"
    magma_benavente2015_vcf          = "${projectDir}/data/magma-references/known/Benavente2015.UVPapproved.rRNAexcluded.vcf.gz"
    magma_benavente2015_vcf_tbi      = "${params.magma_benavente2015_vcf}.tbi"
    magma_coll2014_vcf               = "${projectDir}/data/magma-references/truth/Coll2014.UVPapproved.rRNAexcluded.vcf.gz"
    magma_coll2014_vcf_tbi           = "${params.magma_coll2014_vcf}.tbi"
    magma_coll2018_vcf               = "${projectDir}/data/magma-references/truth/Coll2018.UVPapproved.rRNAexcluded.vcf.gz"
    magma_coll2018_vcf_tbi           = "${params.magma_coll2018_vcf}.tbi"
    magma_napier2020_vcf             = "${projectDir}/data/magma-references/truth/Napier2020.UVPapproved.rRNAexcluded.vcf.gz"
    magma_napier2020_vcf_tbi         = "${params.magma_napier2020_vcf}.tbi"
    magma_walker2015_vcf             = "${projectDir}/data/magma-references/truth/Walker2015.UVPapproved.rRNAexcluded.vcf.gz"
    magma_walker2015_vcf_tbi         = "${params.magma_walker2015_vcf}.tbi"
    magma_zeng2018_vcf               = "${projectDir}/data/magma-references/truth/Zeng2018.UVPapproved.rRNAexcluded.vcf.gz"
    magma_zeng2018_vcf_tbi           = "${params.magma_zeng2018_vcf}.tbi"
    magma_ref_fasta_rdanalyzer       = "${projectDir}/data/magma-references/rdanalyzer/RDs30.fasta"
    magma_snpeff_genome_id           = "Mycobacterium_tuberculosis_h37rv"
    magma_snpeff_config_file         = "${projectDir}/data/magma-references/snpeff/snpEff.config"
    magma_snpeff_db_dir              = "${projectDir}/data/magma-references/snpeff/data/${params.magma_snpeff_genome_id}"
    magma_should_publish_bam         = false   // publish BAMs from HaplotypeCaller
}
