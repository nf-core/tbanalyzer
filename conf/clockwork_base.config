/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Clockwork mode default parameters + process config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Loaded unconditionally (clockwork_* are just namespaced defaults). The
    version-isolated clockwork:v0.12.5 container is pinned inside each module, so
    no container config is needed here. Reference dir bundled under
    data/clockwork-references/ (built by `clockwork prepare_reference`).
----------------------------------------------------------------------------------------
*/

params {
    clockwork_ref_dir           = "${projectDir}/data/clockwork-references/H37Rv"
    clockwork_cortex_mem_height = 22
    clockwork_gvcf              = false
    clockwork_truth_ref         = null
}

process {
    // Publish the Minos-adjudicated final VCF per sample
    withName: 'MINOS_ADJUDICATE' {
        publishDir = [
            path: { "${params.outdir}/clockwork/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }
}
