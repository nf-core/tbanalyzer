process {
    resourceLimits = [
        cpus: 4,
        memory: '8.GB',
        time: '3.h'
    ]
}


params {
    config_profile_name        = 'MTBseq mode using parallel processing test profile'
    config_profile_description = 'Minimal test to check if MTBseq mode with parallel processing is working as intended'


    input             = params.pipelines_testdata_base_path + 'tbanalyzer/mtbseq/samplesheet/test_samplesheet.csv'
    mtbseq_cohort_tsv = params.pipelines_testdata_base_path + 'tbanalyzer/mtbseq/samplesheet/test_cohort.tsv'

    mode = "mtbseq"

    mtbseq_parallel = true


}


