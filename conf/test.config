/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/tbanalyzer -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '2.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal MTBseq test dataset to check pipeline function'

    // Analysis mode
    mode = 'mtbseq'

    // Input data: downsampled M. tuberculosis reads on nf-core/test-datasets (branch: tbanalyzer)
    input             = params.pipelines_testdata_base_path + 'tbanalyzer/mtbseq/samplesheet/test_samplesheet.csv'
    mtbseq_cohort_tsv = params.pipelines_testdata_base_path + 'tbanalyzer/mtbseq/samplesheet/test_cohort.tsv'
}
